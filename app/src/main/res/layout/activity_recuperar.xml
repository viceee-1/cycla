<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar Contraseña"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el correo asociado a tu\ncuenta de Cycla"
        android:textAlignment="center"
        android:textColor="#555555"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEmailRecuperar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:boxBackgroundColor="#FFFFFF"
        android:hint="Correo Electrónico">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmailRecuperar"
            android:inputType="textEmailAddress"
            android:textColor="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarRecuperacion"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="Enviar"
        app:backgroundTint="@color/black"
        android:textColor="#FFFFFF"
        app:cornerRadius="28dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvMensajeBandeja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revisa tu bandeja de entrada!"
        android:textColor="#555555"
        android:textStyle="bold"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/tvVolverLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Volver a iniciar sesión"
        android:textColor="#00BFFF"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>